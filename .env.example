# Example environment variables — DO NOT commit secrets here
# Frontend (Vite) — required for the app to connect to Supabase
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="public-anon-key"
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Server / Admin keys (used by backend services, keep private)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="anon-or-service-key"
SUPABASE_SERVICE_ROLE_KEY="service-role-key"

# Capacitor live-reload (optional - use HTTPS or localhost)
CAP_SERVER_URL="https://localhost:5173"

# AI gateway (used by Supabase edge functions) — DO NOT expose these to the client
# LOVABLE_API_KEY="sk-..."

# Notes:
# - For local development copy this file to `.env` and fill values.
# - For Vercel set the VITE_* vars in the project Environment Variables settings.
# - Do NOT store secrets in the repository.
